  margin-top: 14px;
  border-radius: 4px;
  font-size: 13px;
  color: #1E3A8A;
}

/* STEP 2: Decoding */
.chunk-box { display: flex; flex-direction: column; gap: 12px; }
.chunk-item {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 16px;
}
.chunk-en { font-size: 14.5px; font-weight: 600; color: #1E293B; margin-bottom: 10px; line-height: 1.7; }
.chunk-en mark { background: #FEF3C7; color: #92400E; padding: 2px 4px; border-radius: 2px; font-weight: 600; }

details {
  background: #F8FAFC;
  border: 1px solid var(--border);
  border-radius: 4px;
  margin-top: 8px;
}
summary {
  font-family: var(--mono);
  font-size: 11.5px;
  font-weight: 600;
  color: var(--blue);
  padding: 8px 12px;
  cursor: pointer;
  outline: none;
  user-select: none;
}
.details-content {
  padding: 10px 12px;
  font-size: 13px;
  color: #334155;
  border-top: 1px dashed var(--border);
  line-height: 1.65;
}
.details-content b { color: var(--navy); }

/* STEP 3: Logic Structure */
.flow-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 12px;
}
.flow-card {
  background: var(--white);
  border: 1px solid var(--border);
