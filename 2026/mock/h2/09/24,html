  border: 1px solid #BFDBFE;
  padding: 10px 12px;
  font-size: 12px;
  color: #1E3A8A;
  border-radius: 4px;
  line-height: 1.6;
}

/* Navigation & Footer */
.btn-back-hub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
