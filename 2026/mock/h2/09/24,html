}
.flow-card h4 { font-size: 14.5px; font-weight: 700; margin-bottom: 6px; color: var(--navy); }
.flow-card p { font-size: 12.5px; color: #475569; line-height: 1.6; }

/* STEP 4: Grammar Drill */
.drill-card {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 16px;
  border-radius: 6px;
  margin-bottom: 12px;
}
.drill-q { font-size: 13.5px; font-weight: 600; color: #1E293B; margin-bottom: 10px; }
.drill-options { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
.drill-btn {
  background: #F8FAFC;
  border: 1px solid var(--border);
  font-family: var(--mono);
  font-size: 12px;
  padding: 8px 14px;
  cursor: pointer;
  border-radius: 4px;
  min-height: 40px;
  display: flex;
  align-items: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), background-color 150ms ease;
  outline: none;
}
.drill-btn:active { transform: scale(0.98); background: #E2E8F0; }
.drill-btn:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.drill-feedback {
  display: none;
  font-size: 12.5px;
  padding: 8px 12px;
  border-radius: 4px;
  margin-top: 6px;
  line-height: 1.5;
}

/* STEP 5: Exam Simulation */
.exam-item {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 16px;
  border-radius: 6px;
  margin-bottom: 16px;
}
.exam-item h4 { font-size: 14px; font-weight: 700; margin-bottom: 8px; color: var(--navy); }
.exam-passage {
  background: #F8FAFC;
  border: 1px solid var(--border);
  padding: 12px;
  font-size: 13px;
  line-height: 1.7;
  color: #334155;
  margin-bottom: 10px;
  border-radius: 4px;
}
.exam-choices { font-size: 12.5px; color: #334155; line-height: 1.75; margin-bottom: 10px; }
.answer-content {
